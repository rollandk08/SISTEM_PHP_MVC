{
  "name": "isam/northwind-mvc",
  "description": "Sistema empresarial educativo Northwind, local y sin servicios externos",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.0",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-mbstring": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "lint": "@php tools/lint.php",
    "verify": "@php tools/verify.php"
  },
  "config": {
    "sort-packages": true
  }
}
